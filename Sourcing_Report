def clean_date(value):
    if isinstance(value, str):
        value = value.strip()
        if value.lower() in ["na", "n/a", "", "null", "none", "NA"]:
            return None
        date_formats = [
            "%Y-%m-%d", "%d/%m/%Y", "%d-%m-%Y", "%m/%d/%Y",
            "%b %d, %Y", "%b. %d, %Y", "%B %d, %Y", "%B. %d, %Y"
        ]
        for fmt in date_formats:
            try:
                return datetime.strptime(value, fmt).date()
            except ValueError:
                continue
        return None
    return value

def clean_integer(value):
    if isinstance(value, str):
        value = value.strip()
        if value.lower() in ["na", "n/a", "", "null", "none"]:
            return "Not Available"
        if value.isdigit():
            return int(value)
        return None
    elif isinstance(value, (int, float)):
        return int(value)
    return None
def clean_time_duration(value):
    if isinstance(value, str):
        value = value.strip()
        if value.lower() in ["na", "n/a", "", "null", "none"]:
            return None
        try:
            # validate and return as string
            dt = datetime.strptime(value, "%H:%M:%S")
            return dt.strftime("%H:%M:%S")
        except ValueError:
            return None
    return None

